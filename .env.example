# Twilio launcher
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15555550100
MY_PHONE_NUMBER=+15555550101

# Public tunnel hostname only; do not include https://
PUBLIC_HOST=example.ngrok-free.app

# Streaming transcription
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi

# Conversation-quality analysis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional persistence
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0

# Optional two-party mode
ENABLE_AGENT_CALL=false
FRIEND_PHONE_NUMBER=+15555550102
